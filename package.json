{
  "name": "precatos",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de originação de precatórios — módulo 1: captação (DJEN + DEPRE) em Cloudflare Workers + Supabase",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:start": "bash scripts/db-local.sh start",
    "db:stop": "bash scripts/db-local.sh stop",
    "db:reset": "bash scripts/db-local.sh reset",
    "local:djen": "tsx scripts/run-local.ts djen",
    "local:depre": "tsx scripts/run-local.ts depre",
    "local:status": "tsx scripts/run-local.ts status",
    "demo:djen": "tsx scripts/demo-djen-offline.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.9",
    "typescript": "^5.5.4",
    "wrangler": "^4.0.0"
  }
}
